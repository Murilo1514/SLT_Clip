{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--anno_root",
                "./preprocess/Phoenix14T",
                "--model_name", 
                "openai/clip-vit-large-patch14",
                "--video_root",
                "./phoenix_dl/Phoenix14T/PHOENIX-2014-T-release-v3/PHOENIX-2014-T/",
                "--cache_dir",
                "./cache/",
                "--save_dir",
                "./checkpoint/",
                "--s2_mode",
                "s2wrapping",
                "--scales", 
                "1", 
                "2",
                "--batch_size", 
                "32",
                "--device", 
                "cpu"
            ]
        },
        {

            "name": "train",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "env": {
                "WANDB_MODE":"offline",
                "CUDA_LAUNCH_BLOCKING": "1" 
            },
            "args": [
                "-c",
                "configs/finetune.yaml",
                "-e",
                "bleu"
            ]
        },  

        {
            "name": "mediapipe",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/mediapipe_extract_feature.py",
            "console": "integratedTerminal",
            "args": [
                "--anno_root",
                "./preprocess/Phoenix14T",
                "--video_root",
                "./phoenix_dl/Phoenix14T/PHOENIX-2014-T-release-v3/PHOENIX-2014-T/",
                "--save_dir",
                "./datasets_features",
                "--cache_dir",
                "./models",
                "--model_type",
                "auto",
                "--num_workers",
                "1",
                "--window_size",
                "16",
                "--overlap_size",
                "8",
                "--mode",
                "dev",
                "test",
                "train"
            ]

        },

        {
            "name": "vjepa2_64fpc",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/vjepa2_extract_feature.py",
            "console": "integratedTerminal",
            "args": [
                "--anno_root",
                "./preprocess/Phoenix14T",
                "--video_root",
                "./phoenix_dl/PHOENIX-2014-T-release-v3/PHOENIX-2014-T/",
                "--save_dir",
                "./datasets_features",
                "--model_name",
                "facebook/vjepa2-vitl-fpc64-256",
                "--cache_dir",
                "./cache/",
                "--overlap_size",
                "48",
                "--batch_size",
                "4",
                "--device",
                "cpu"
            ]
        },

        {
            "name": "vjepa2_16fpc",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/vjepa2_extract_feature.py",
            "console": "integratedTerminal",
            "args": [
                "--anno_root",
                "./preprocess/Phoenix14T",
                "--video_root",
                "./phoenix_dl/PHOENIX-2014-T-release-v3/PHOENIX-2014-T/",
                "--save_dir",
                "./datasets_features",
                "--model_name",
                "facebook/vjepa2-vitl-fpc16-256-ssv2",
                "--cache_dir",
                "./cache/",
                "--overlap_size",
                "8",
                "--batch_size",
                "4",
                "--device",
                "cpu",
                "--frames_per_clip",
                "16"
            ]
        }
    ]
}

